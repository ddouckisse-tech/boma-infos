# Deploiement Convex (genere par `bunx convex dev`)
# Projet « boma-info » de l'equipe okatech, deploiement de developpement cloud :
#   bunx convex dev --configure existing --team okatech --project boma-info --once
# Sans compte Convex, un backend local et anonyme (valeurs ci-dessous) :
#   CONVEX_AGENT_MODE=anonymous bunx convex dev --once
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Variable lue SUR le deploiement Convex, pas ici. Absente, convex/auth.ts
# prend http://localhost:3040 ; a poser pour un site public :
#   bunx convex env set SITE_URL https://www.boma-infos.com

# URL publique du site (canoniques, Open Graph, sitemap, RSS).
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Facultatif : méthode de validation Google Search Console par balise HTML.
# La validation par fichier utilise déjà public/googleab6f71318677252e.html.
GOOGLE_SITE_VERIFICATION=

# Publicités : campaigns (défaut), off (aucun encart), preview (autopromotions de recette).
# Aucune campagne commerciale n'est ajoutée automatiquement.
ADS_MODE=campaigns
# Facultatif : ordonnanceur de campagnes internes, JSON {"campaignIds":[...]}, HTTPS.
# Les identifiants doivent correspondre à des campagnes actives de la médiathèque.
# Ce n'est pas un point d'injection de tags AdSense ou HTML.
ADS_FEED_URL=
ADS_FEED_TOKEN=

# Mode régie optionnel : ADS_MODE=adsense. Aucun chargement Google si incomplet.
# Valeurs officielles de votre compte et de ses unités display (ne pas inventer).
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HOME_PRIMARY=
ADSENSE_SLOT_HOME_SECONDARY=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_LISTING=
# Intégration de votre CMP certifiée Google/TCF : URL du script, ID CMP et
# origines HTTPS explicites séparées par des virgules (inclure celle du script).
ADSENSE_CMP_SCRIPT_URL=
ADSENSE_CMP_ID=
ADSENSE_CMP_ALLOWED_ORIGINS=
# Recette locale sans écriture de statistiques d'audience : 1 désactive les compteurs.
AUDIENCE_DISABLED=
