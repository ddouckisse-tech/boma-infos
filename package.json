{
  "name": "le-corporate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun run budget",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "convex:dev": "convex dev --tail-logs disable",
    "verify": "bun run typecheck && bun run lint && bun run build",
    "dev:full": "convex dev --tail-logs disable --start 'next dev'",
    "budget": "bun run scripts/check-budget.ts",
    "build:only": "next build",
    "media": "bun run scripts/fetch-media.ts",
    "documents": "bun run scripts/make-documents.ts",
    "icons": "bun run scripts/make-icons.ts",
    "seed": "convex run seeding:run '{\"reset\": true}'",
    "compte": "bun run scripts/create-account.ts",
    "agents:cle": "bun run scripts/push-agent-key.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@hookform/resolvers": "^5.9.1",
    "better-auth": "1.6.21",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "Le Corporate \u2014 magazine \u00e9conomique gabonais (refonte applicative)"
}
